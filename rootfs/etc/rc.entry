#!/bin/bash
set -e

# 各メールアカウントの受信設定
if [[ ! -f /ext/fetchmailrc ]]; then
    echo "missing: /ext/fetchmailrc" >&2
    exit 1
fi

# Gmailのアプリパスワード
: "${TRANSMAIL_GMAIL_USER:?missing: \$TRANSMAIL_GMAIL_USER}"
: "${TRANSMAIL_GMAIL_APP_PASSWORD:?missing: \$TRANSMAIL_GMAIL_APP_PASSWORD}"
echo "[smtp.gmail.com]:587 ${TRANSMAIL_GMAIL_USER}:${TRANSMAIL_GMAIL_APP_PASSWORD}" > /etc/postfix/sasl_passwd
postmap /etc/postfix/sasl_passwd
chmod 600 /etc/postfix/sasl_passwd /etc/postfix/sasl_passwd.db

# postfixはchrootするのでDockerではこれが必要
cp /etc/resolv.conf /var/spool/postfix/etc/resolv.conf

echo "starting postfix"
postfix start

echo "starting fetchmail as transmail"
exec gosu transmail fetchmail --nodetach -f /ext/fetchmailrc
