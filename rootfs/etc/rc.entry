#!/bin/bash
set -e

# 各メールアカウントの受信設定
: "${TRANSMAIL_FORWARD_TO:?missing: \$TRANSMAIL_FORWARD_TO}"
[[ -f /ext/fetchmailrc ]] || { echo "missing: /ext/fetchmailrc" >&2; exit 1; }

# fetchmailは設定ファイルのオーナーに厳しいためコピー
install -m 600 -o transmail -g transmail \
    /ext/fetchmailrc \
    /home/transmail/.fetchmailrc

# SMTPサーバの認証情報
: "${TRANSMAIL_SASL_PASSWORD:?missing: \$TRANSMAIL_SASL_PASSWORD}"
echo "$TRANSMAIL_SASL_PASSWORD" > /etc/postfix/sasl_passwd
postmap /etc/postfix/sasl_passwd
chmod 600 /etc/postfix/sasl_passwd /etc/postfix/sasl_passwd.db

# postfixはchrootするためコピー
cp /etc/resolv.conf /var/spool/postfix/etc/resolv.conf

echo "starting postfix"
postfix start

echo "starting fetchmail as transmail"
exec gosu transmail fetchmail --nodetach
